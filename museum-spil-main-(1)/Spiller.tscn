[sub_resource type="GDScript" id="GDScript_w6gvy"]
script/source = "
extends CharacterBody3D

const SPEED = 5.0
const JUMP_VELOCITY = 4.5
const MOUSE_SENSITIVITY = 0.002
const PAINTBALL_SCENE = preload(\"res://PaintBall.tscn\")
const SKUD_PAUSE = 0.15

@onready var camera: Camera3D = $Camera3D
@onready var pistol: Node3D = $Camera3D/Malerpistolos
@onready var munding: Marker3D = $Camera3D/Malerpistolos/Munding

var mouse_captured = false
var pistol_fremme = false
var skud_timer = 0.0


func _ready() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	mouse_captured = true
	pistol.visible = false


func _unhandled_input(event: InputEvent) -> void:
	# Kig rundt med musen
	if event is InputEventMouseMotion and mouse_captured:
		rotate_y(-event.relative.x * MOUSE_SENSITIVITY)
		camera.rotate_x(-event.relative.y * MOUSE_SENSITIVITY)
		camera.rotation.x = clamp(
			camera.rotation.x,
			deg_to_rad(-89),
			deg_to_rad(89)
		)

	# Frigiv musen med Escape
	if event.is_action_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		mouse_captured = false

	# Klik for at fange musen igen
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			if not mouse_captured:
				Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
				mouse_captured = true

	# Tag pistolen frem eller gem den med tast 1
	if event is InputEventKey:
		if event.pressed and not event.echo:
			if event.keycode == KEY_1:
				pistol_fremme = not pistol_fremme
				pistol.visible = pistol_fremme


func _process(delta: float) -> void:
	skud_timer = maxf(0.0, skud_timer - delta)

	# Skyd gentagne gange, mens venstre museknap holdes nede
	if mouse_captured and pistol_fremme:
		if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
			if skud_timer <= 0.0:
				skyd()
				skud_timer = SKUD_PAUSE


func _physics_process(delta: float) -> void:
	# Tyngdekraft
	if not is_on_floor():
		velocity += get_gravity() * delta

	# Hop med mellemrum
	if Input.is_key_pressed(KEY_SPACE) and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# WASD-bevægelse
	var input_dir := Vector2.ZERO

	if Input.is_key_pressed(KEY_A):
		input_dir.x -= 1
	if Input.is_key_pressed(KEY_D):
		input_dir.x += 1
	if Input.is_key_pressed(KEY_W):
		input_dir.y -= 1
	if Input.is_key_pressed(KEY_S):
		input_dir.y += 1

	input_dir = input_dir.normalized()

	# Bevægelse i forhold til spillerens retning
	var direction := transform.basis * Vector3(
		input_dir.x, 0, input_dir.y
	)
	direction = direction.normalized()

	if direction.length() > 0:
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

	move_and_slide()


func skyd() -> void:
	var fra = camera.global_position
	var til = fra + (-camera.global_transform.basis.z * 100.0)

	var forespoergsel = PhysicsRayQueryParameters3D.create(fra, til)
	forespoergsel.exclude = [get_rid()]

	var resultat = get_world_3d().direct_space_state.intersect_ray(forespoergsel)

	var maalpunkt: Vector3
	if resultat.is_empty():
		maalpunkt = til
	else:
		maalpunkt = resultat[\"position\"]

	var kugle = PAINTBALL_SCENE.instantiate()
	get_tree().current_scene.add_child(kugle)

	var start_position = munding.global_position
	var retning = (maalpunkt - start_position).normalized()

	kugle.start(start_position, retning)
"

