[sub_resource type="GDScript" id="GDScript_r3fl7"]
script/source = "
extends Area3D

@export var museum_robot: Node3D
@export var robot_stop: Marker3D

@export_multiline var explanation: String = \"Dette er et kunstværk på museet.\"

func _ready():
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node3D):
	print(\"Noget kom ind i maleriets område!\")

	if body.is_in_group(\"player\"):
		print(\"Det er spilleren!\")

		if museum_robot != null and robot_stop != null:
			print(\"Robotten har fået et nyt mål!\")

			museum_robot.call(
				\"set_target\",
				robot_stop,
				explanation
			)

		print(\"Spilleren har fundet et maleri!\")
"

